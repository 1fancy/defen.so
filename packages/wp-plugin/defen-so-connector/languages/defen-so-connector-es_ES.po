msgstr "Cortafuegos y refuerzo"

#: views/admin-page.php:93
msgid "Scans"
msgstr "Análisis"

#: views/admin-page.php:94
msgid "Rate limits"
msgstr "Límites de tasa"

#: views/admin-page.php:95
msgid "Uptime &amp; alerts"
msgstr "Disponibilidad y alertas"

#: views/admin-page.php:96
